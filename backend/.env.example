# Copy this file to .env and fill in real values. Never commit .env.

# --- General ---
ENVIRONMENT=development                # development | production
CORS_ORIGINS=http://localhost:5173      # comma-separated list of allowed frontend origins
DATA_DIR=./data                         # where cached JSON snapshots are written
# IANA timezone name - what "today"/"this week"/"this month" mean for
# calendar events and spending. Matters because the server itself may run
# on UTC regardless of where you actually live.
TIMEZONE=America/Los_Angeles

# --- SimpleFIN Bridge (e.g. https://beta-bridge.simplefin.org) ---
# No client ID/secret here - the credentials live inside the access URL
# produced by claiming a one-time setup token (POST /api/simplefin/claim,
# or the "Link SimpleFIN" box in the frontend). Nothing to fill in below;
# this just says where that access URL gets cached once claimed.
# NOT committed. In production, consider a proper secrets store instead of a flat file.
SIMPLEFIN_ACCESS_URL_STORE=./data/simplefin_access_url.txt

# --- Weather (NWS: no key required, just needs a lat/lon and a contact User-Agent) ---
WEATHER_LAT=
WEATHER_LON=
NWS_USER_AGENT=daily-dashboard (you@example.com)

# --- Google Calendar ---
# OAuth client downloaded from Google Cloud Console (Desktop app credentials).
GOOGLE_CLIENT_SECRETS_FILE=./data/google_client_secret.json
# Where the generated OAuth token (refresh token) is cached after the one-time
# authorization flow. NOT committed.
GOOGLE_TOKEN_FILE=./data/google_token.json
GOOGLE_CALENDAR_ID=primary

# --- Manual transactions / receipt scanning ---
# Receipt scanning uses local OCR (Tesseract) - free, no API key. Just needs
# the tesseract binary installed: `brew install tesseract` (macOS) or
# `apt-get install tesseract-ocr` (Ubuntu/server).
MANUAL_TRANSACTIONS_STORE=./data/manual_transactions.json
